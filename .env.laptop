# =================================================================
# Profile: LAPTOP — i5/i7 8-12 cores, 16GB RAM
# Dành cho: phát triển, demo, benchmark local
# =================================================================
SPARK_WORKER_COUNT=3
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=2g

KAFKA_HEAP_OPTS=-Xmx1g -Xms512m
KAFKA_NUM_PARTITIONS=3

CONNECT_HEAP=-Xmx512m -Xms256m

MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MONGO_CACHE_SIZE_GB=1

# ── Capacity Stress Test (demo/demo_server.py) ──────────────────────
# Đổi rates để test nhiều kịch bản khác nhau, không cần restart stack
# Laptop ~300 rec/s max → resolution quanh điểm bão hòa
STRESS_RATES=50,100,150,200,250,300,400
STRESS_DURATION=40
STRESS_SAT_RATIO=0.5
