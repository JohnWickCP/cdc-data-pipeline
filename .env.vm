# =================================================================
# Profile: VM — Cloud VM 16 vCPU, 32GB RAM
# Dành cho: benchmark cloud, AWS c6i.4xlarge, GCP c2-standard-16
# Lưu ý: xóa VM sau khi benchmark để tránh bị charge!
# Chạy: bash start.sh --profile=vm
# =================================================================

# Spark workers (3 workers hardcoded trong docker-compose.yml)
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g

KAFKA_HEAP_OPTS=-Xmx2g -Xms1g
KAFKA_NUM_PARTITIONS=3

CONNECT_HEAP=-Xmx1g -Xms512m

MYSQL_INNODB_BUFFER_POOL_SIZE=2G
MONGO_CACHE_SIZE_GB=4
