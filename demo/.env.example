# CDC Demo Server — Connection Config
# Copy sang .env rồi điều chỉnh nếu chạy trên máy khác
# Mặc định là 127.0.0.1 (pipeline chạy local)

# MySQL (exposed tại host port 3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=inventory

# Redis (exposed tại host port 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MongoDB (exposed tại host port 27017)
MONGO_URI=mongodb://127.0.0.1:27017

# Prometheus (exposed tại host port 9090)
PROMETHEUS_URL=http://127.0.0.1:9090

# Demo server port
DEMO_PORT=8888

# ── Máy khác (ví dụ: pipeline trên VM có IP 192.168.1.100) ──
# MYSQL_HOST=192.168.1.100
# REDIS_HOST=192.168.1.100
# MONGO_URI=mongodb://192.168.1.100:27017
# PROMETHEUS_URL=http://192.168.1.100:9090

# ── Capacity Stress Test (tuning theo môi trường) ──────────────────
# STRESS_RATES    : danh sách tốc độ inject (rec/s), cách nhau bằng dấu phẩy
# STRESS_DURATION : giây mỗi level (10s warm-up cố định + phần còn lại lấy mẫu)
# STRESS_SAT_RATIO: lag > rate * ratio → saturating (mặc định 0.5 = nửa giây lag)

# Laptop (i7-12th, 16GB) — default, không cần set:
# STRESS_RATES=100,200,500,1000,2000
# STRESS_DURATION=40
# STRESS_SAT_RATIO=0.5

# VM (16 vCPU, 32GB) — ceiling cao hơn, cần nhiều thời gian warm-up hơn:
# STRESS_RATES=500,1000,2000,5000,10000
# STRESS_DURATION=60
# STRESS_SAT_RATIO=0.5
