# ==========================================
# Template cấu hình môi trường — Metrics Exporter
# Copy file này thành .env và điền giá trị thật
# ==========================================
#
# CẢNH BÁO: Không commit file .env thật lên git!
# File .env đã được gitignore.

# MySQL
MYSQL_HOST=cdc-mysql          # Trong Docker: tên container
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root           # Đổi nếu deploy production
MYSQL_DB=inventory

# MongoDB
MONGO_URI=mongodb://cdc-mongodb:27017

# Redis
REDIS_HOST=cdc-redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKER=cdc-kafka:29092  # Internal Docker network port

# Benchmark
BENCHMARK_DIR=/app/benchmark  # Được set tự động bởi docker-compose
